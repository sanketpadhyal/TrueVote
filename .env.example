# ==============================================================================
# TrueVote Environment Configuration Example
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Ethereum Sepolia Network Configuration
REACT_APP_CHAIN_ID=11155111
REACT_APP_NETWORK_NAME=Sepolia
REACT_APP_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Smart Contract Addresses (Sepolia Testnet)
REACT_APP_VOTING_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
REACT_APP_VERIFIER_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Pinata IPFS Decentralized Storage
REACT_APP_PINATA_API_KEY=your_pinata_api_key_here
REACT_APP_PINATA_SECRET_KEY=your_pinata_secret_key_here
REACT_APP_PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/

# EIP-712 Gasless Relayer Service
REACT_APP_RELAYER_ENDPOINT=https://relayer.truevote.org/api/v1/relay
